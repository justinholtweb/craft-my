{% extends '_layouts/cp' %}

{% set title = 'MYOB log'|t('my') %}
{% set selectedSubnavItem = 'log' %}

{% set crumbs = [
    { label: 'MYOB'|t('my'), url: url('my') },
] %}

{% block content %}
    {# The filter is `action_`, not `action`: `action` is how Craft is told which controller action
       to run, so a query string carrying one would be routed rather than filtered. #}
    <form method="get" class="flex" style="gap: 8px; margin-bottom: 16px;">
        <select name="action_" onchange="this.form.submit()">
            <option value="">{{ 'All actions'|t('my') }}</option>
            {% for action in actions %}
                <option value="{{ action }}" {{ criteria.action ?? '' == action ? 'selected' }}>{{ action }}</option>
            {% endfor %}
        </select>

        <select name="level" onchange="this.form.submit()">
            <option value="">{{ 'All levels'|t('my') }}</option>
            {% for value, label in { info: 'Info'|t('my'), warning: 'Warning'|t('my'), error: 'Error'|t('my') } %}
                <option value="{{ value }}" {{ criteria.level ?? '' == value ? 'selected' }}>{{ label }}</option>
            {% endfor %}
        </select>
    </form>

    {% if entries is empty %}
        <div class="pane"><p class="light">{{ 'Nothing logged yet.'|t('my') }}</p></div>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'When'|t('my') }}</th>
                    <th>{{ 'Action'|t('my') }}</th>
                    <th>{{ 'Request'|t('my') }}</th>
                    <th>{{ 'Code'|t('my') }}</th>
                    <th>{{ 'Time'|t('my') }}</th>
                    <th>{{ 'Summary'|t('my') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    <tr>
                        <td class="light" style="white-space: nowrap;">
                            <a href="{{ url('my/log/' ~ entry.id) }}">{{ entry.dateCreated|datetime('short') }}</a>
                        </td>
                        <td>
                            <span class="status {{ entry.getLevelColor() }}"></span>
                            {{ entry.action }}
                        </td>
                        <td class="code" style="font-size: 11px;">{{ entry.method }} {{ entry.endpoint }}</td>
                        <td>{{ entry.statusCode ?? '—' }}</td>
                        <td class="light">{{ entry.durationMs ? entry.durationMs ~ 'ms' : '' }}</td>
                        <td>{{ entry.summary ?? entry.message|slice(0, 90) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% set totalPages = (total / perPage)|round(0, 'ceil') %}
        {% if totalPages > 1 %}
            <div class="flex" style="gap: 8px; margin-top: 16px;">
                {% if page > 1 %}
                    <a class="btn" href="{{ url('my/log', criteria|merge({ page: page - 1 })) }}">{{ '← Previous'|t('my') }}</a>
                {% endif %}
                <span class="light">{{ 'Page {page} of {total}'|t('my', { page: page, total: totalPages }) }}</span>
                {% if page < totalPages %}
                    <a class="btn" href="{{ url('my/log', criteria|merge({ page: page + 1 })) }}">{{ 'Next →'|t('my') }}</a>
                {% endif %}
            </div>
        {% endif %}

        {# A real, top-level form — this page is not inside one. #}
        <form method="post" accept-charset="UTF-8" style="margin-top: 24px;">
            {{ csrfInput() }}
            {{ actionInput('my/log/clear') }}
            {{ redirectInput('my/log') }}
            <button type="submit" class="btn">{{ 'Clear the log'|t('my') }}</button>
        </form>
    {% endif %}
{% endblock %}
