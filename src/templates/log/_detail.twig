{% extends '_layouts/cp' %}

{% set title = entry.action ~ ' — ' ~ entry.dateCreated|datetime('short') %}
{% set selectedSubnavItem = 'log' %}

{% set crumbs = [
    { label: 'MYOB'|t('my'), url: url('my') },
    { label: 'Log'|t('my'), url: url('my/log') },
] %}

{% set levelLabels = { info: 'Info'|t('my'), warning: 'Warning'|t('my'), error: 'Error'|t('my') } %}

{% block content %}
    <table class="data fullwidth">
        <tbody>
            <tr>
                <th scope="row" class="thin nowrap">{{ 'Level'|t('my') }}</th>
                <td><span class="status {{ entry.getLevelColor() }}" aria-hidden="true"></span> {{ levelLabels[entry.level] ?? entry.level }}</td>
            </tr>
            <tr>
                <th scope="row" class="thin nowrap">{{ 'Request'|t('my') }}</th>
                <td>{% if entry.endpoint %}<code>{{ entry.method }} {{ entry.endpoint }}</code>{% else %}<span class="light">{{ 'None'|t('my') }}</span>{% endif %}</td>
            </tr>
            <tr>
                <th scope="row" class="thin nowrap">{{ 'Status'|t('my') }}</th>
                <td>{% if entry.statusCode %}{{ entry.statusCode }}{% else %}<span class="light">{{ 'None'|t('my') }}</span>{% endif %}</td>
            </tr>
            <tr>
                <th scope="row" class="thin nowrap">{{ 'Duration'|t('my') }}</th>
                <td>{% if entry.durationMs %}{{ '{ms} ms'|t('my', { ms: entry.durationMs }) }}{% else %}<span class="light">{{ 'None'|t('my') }}</span>{% endif %}</td>
            </tr>
            <tr>
                <th scope="row" class="thin nowrap">{{ 'Order'|t('my') }}</th>
                <td>
                    {% if entry.orderId %}
                        <a href="{{ cpUrl('commerce/orders/' ~ entry.orderId) }}">#{{ entry.orderId }}</a>
                    {% else %}
                        <span class="light">{{ 'None'|t('my') }}</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th scope="row" class="thin nowrap">{{ 'Summary'|t('my') }}</th>
                <td>{% if entry.summary %}{{ entry.summary }}{% else %}<span class="light">{{ 'None'|t('my') }}</span>{% endif %}</td>
            </tr>
        </tbody>
    </table>

    {% if entry.message %}
        <hr>
        <h2>{{ 'Message'|t('my') }}</h2>
        <p>{{ entry.message }}</p>
    {% endif %}

    {% if entry.request %}
        <hr>
        <h2>{{ 'Request'|t('my') }}</h2>
        <pre class="code" tabindex="0" aria-label="{{ 'Request'|t('my') }}" style="max-height: 420px; overflow: auto;">{{ entry.request }}</pre>
    {% endif %}

    {% if entry.response %}
        <hr>
        <h2>{{ 'Response'|t('my') }}</h2>
        <pre class="code" tabindex="0" aria-label="{{ 'Response'|t('my') }}" style="max-height: 420px; overflow: auto;">{{ entry.response }}</pre>
    {% endif %}
{% endblock %}
