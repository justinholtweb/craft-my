{# ------------------------------------------------------------------------ JS #}
{% js %}
(function () {
    var post = function (action, data, onDone) {
        Craft.sendActionRequest('POST', action, { data: data || {} })
            .then(function (response) { onDone(response.data || {}); })
            .catch(function (error) {
                var data = (error && error.response && error.response.data) || {};
                onDone({ success: false, message: data.message || data.error || Craft.t('my', 'The request failed.') });
            });
    };

    var say = function (key, result) {
        var el = document.querySelector('[data-my-result="' + key + '"]');
        if (!el) return;
        el.textContent = result.message || '';
        el.classList.toggle('error', result.success === false);
        el.classList.toggle('light', result.success !== false);
    };

    var renderFiles = function (files) {
        var list = document.querySelector('[data-my-files]');
        if (!list) return;
        list.innerHTML = '';

        (files || []).forEach(function (file) {
            var row = document.createElement('li');
            row.className = 'flex flex-wrap';
            row.style.paddingBlock = 'var(--2xs)';

            var name = document.createElement('strong');
            name.textContent = file.Name;

            var id = document.createElement('code');
            id.className = 'light';
            id.textContent = file.Id;

            var choose = document.createElement('button');
            choose.type = 'button';
            choose.className = 'btn small';
            choose.textContent = Craft.t('my', 'Use this file');
            choose.addEventListener('click', function () {
                choose.classList.add('loading');
                post('my/settings/select-company-file', { id: file.Id, uri: file.Uri, name: file.Name }, function (result) {
                    choose.classList.remove('loading');
                    say('files', result);
                });
            });

            row.appendChild(name);
            row.appendChild(id);
            row.appendChild(choose);
            list.appendChild(row);
        });
    };

    document.querySelectorAll('[data-my-action]').forEach(function (button) {
        button.addEventListener('click', function () {
            var key = button.getAttribute('data-my-result-for');
            button.classList.add('loading');
            post(button.getAttribute('data-my-action'), {}, function (result) {
                button.classList.remove('loading');
                say(key, result);
                if (key === 'files') renderFiles(result.files);
            });
        });
    });

    var disconnect = document.querySelector('[data-my-disconnect]');
    if (disconnect) {
        disconnect.addEventListener('click', function () {
            if (!confirm(Craft.t('my', 'Disconnect from MYOB? Nothing in MYOB is changed.'))) return;
            disconnect.classList.add('loading');
            post('my/settings/disconnect', {}, function () { window.location.reload(); });
        });
    }
})();
{% endjs %}
