{# Field names carry no `settings[…]` prefix. `craft\base\Plugin::settingsResponse()` runs this
   template's output through `View::namespaceInputs(…, 'settings')`, so a name written as
   `settings[foo]` here posts as `settings[settings][foo]` and saves nothing at all — the screen
   looks perfect, Craft says "Plugin settings saved", and every edit is silently discarded.

   Nothing on this screen is inside a `<form>` of its own either. The settings screen *is* a form,
   and a nested one is not ignored: the parser drops the inner tag and keeps its children, so a
   second `action` input lands beside the real one and Save runs whichever came last. Buttons post
   with `Craft.sendActionRequest`. #}
{% import '_includes/forms' as forms %}

{% set isConnected = connection.isConnected() %}
{% set isLocal = settings.isLocal() %}

{# Buttons and result lines are found by `data-my-*` attributes, never by `id`: Craft namespaces
   every `id` in this template's output (`my-test` arrives as `settings-my-test`) but not the JS. #}
{% do view.registerTranslations('my', [
    'The request failed.',
    'Use this file',
    'Disconnect from MYOB? Nothing in MYOB is changed.',
]) %}

{% if not commerceReady %}
    <div class="readable">
        <blockquote class="note warning">
            <p>{{ 'Craft Commerce is not installed or enabled. My needs it to do anything.'|t('my') }}</p>
        </blockquote>
    </div>
    <hr>
{% endif %}

{# ---------------------------------------------------------------- Connection #}
<h2>{{ 'Connection'|t('my') }}</h2>

<div class="pane">
    <div class="flex flex-wrap">
        <span class="status {{ isConnected ? 'on' : 'off' }}" aria-hidden="true"></span>
        <strong>
            {% if isConnected %}
                {{ 'Connected to {name}'|t('my', { name: connection.getLabel() }) }}
            {% else %}
                {{ 'Not connected'|t('my') }}
            {% endif %}
        </strong>
        {% if connection.dateLastVerified %}
            <span class="light">{{ 'Last checked {date}'|t('my', { date: connection.dateLastVerified|datetime('short') }) }}</span>
        {% endif %}
    </div>

    <div class="flex flex-wrap" style="margin-block-start: var(--m);">
        {% if not isLocal %}
            <a class="btn" href="{{ actionUrl('my/oauth/connect') }}">
                {{ isConnected ? 'Reconnect'|t('my') : 'Connect to MYOB'|t('my') }}
            </a>
        {% endif %}
        <button type="button" class="btn" data-my-action="my/settings/test" data-my-result-for="test">{{ 'Test connection'|t('my') }}</button>
        {% if isConnected %}
            <button type="button" class="btn caution" data-my-disconnect>{{ 'Disconnect'|t('my') }}</button>
        {% endif %}
        <span class="light" data-my-result="test" role="status" aria-live="polite"></span>
    </div>
</div>

{{ forms.selectField({
    label: 'Where MYOB lives'|t('my'),
    instructions: 'Cloud files are reached over the internet with OAuth. A local AccountRight server runs on the merchant’s own machine and uses the company file login directly.'|t('my'),
    id: 'mode',
    name: 'mode',
    value: settings.mode,
    options: [
        { label: 'MYOB cloud (AccountRight Live / MYOB Business)'|t('my'), value: 'cloud' },
        { label: 'AccountRight local server'|t('my'), value: 'local' },
    ],
    toggle: true,
    targetPrefix: 'my-mode-',
}) }}

<div id="my-mode-cloud" class="{{ isLocal ? 'hidden' }}">
    <div class="pane">
        {{ forms.copytextField({
            label: 'Redirect URL'|t('my'),
            instructions: 'Create an app at {link} and register this redirect URL against it, exactly as printed — MYOB matches it character for character.'|t('my', {
                link: tag('a', {
                    href: 'https://my.myob.com.au/au/bd/DevAppList.aspx',
                    rel: 'noopener noreferrer',
                    target: '_blank',
                    text: 'developer.myob.com',
                }),
            }),
            id: 'my-redirect-uri',
            value: settings.getRedirectUri(),
            class: 'code',
            first: true,
        }) }}
    </div>

    {{ forms.autosuggestField({
        label: 'API key'|t('my'),
        instructions: 'The developer key for your MYOB app.'|t('my'),
        id: 'clientId',
        name: 'clientId',
        value: settings.clientId,
        suggestEnvVars: true,
    }) }}

    {{ forms.autosuggestField({
        label: 'API secret'|t('my'),
        id: 'clientSecret',
        name: 'clientSecret',
        value: settings.clientSecret,
        suggestEnvVars: true,
    }) }}
</div>

<div id="my-mode-local" class="{{ not isLocal ? 'hidden' }}">
    {{ forms.textField({
        label: 'AccountRight server URL'|t('my'),
        instructions: 'Where the AccountRight API service is listening. Craft has to be able to reach it — a server on the bookkeeper’s desktop is not reachable from a hosted site.'|t('my'),
        id: 'localBaseUrl',
        name: 'localBaseUrl',
        value: settings.localBaseUrl,
        errors: settings.getErrors('localBaseUrl'),
    }) }}
</div>

<div class="pane">
    <p>
        {{ 'These are the login for the **company file itself**, not for your MYOB account. They are two different things and MYOB rejects both with the same 401.'|t('my')|md(inlineOnly=true) }}
    </p>

    {{ forms.autosuggestField({
        label: 'Company file username'|t('my'),
        instructions: 'Usually `Administrator`.'|t('my'),
        id: 'cfUsername',
        name: 'cfUsername',
        value: settings.cfUsername,
        suggestEnvVars: true,
    }) }}

    {{ forms.autosuggestField({
        label: 'Company file password'|t('my'),
        instructions: 'Leave blank if the file has no password.'|t('my'),
        id: 'cfPassword',
        name: 'cfPassword',
        value: settings.cfPassword,
        suggestEnvVars: true,
    }) }}
</div>

<div class="pane">
    <h3>{{ 'Company file'|t('my') }}</h3>

    {{ forms.textField({
        label: 'Company file ID'|t('my'),
